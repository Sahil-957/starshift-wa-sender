PORT=5001
JWT_SECRET=change-this-to-a-long-random-string

# The admin logs in to the extension with this mobile number (country code + number) and password,
# then adds customers and generates their passwords from the Admin Panel.
ADMIN_MOBILE=917028080364
ADMIN_PASSWORD=change-this-admin-password

# Where customers reach this backend from their own browser. Activation links are built from it,
# so it must be the public address once you host this - "localhost" only works on your own PC.
PUBLIC_BASE_URL=http://localhost:5001

# The Chrome extension's ID (chrome://extensions with Developer mode on). The activation page needs
# it to hand the code straight to the extension; without it customers paste the code by hand.
EXTENSION_ID=

# How the password-reset code is delivered. Left blank it is only printed in this console.
# SMS_PROVIDER=twilio

# The number customers are told to contact for help, shown on the activation page.
SUPPORT_MOBILE=917028080364

# Shown on the /privacy and /terms pages. Fill these in before you publish those URLs anywhere
# (the Chrome Web Store asks for a privacy policy URL). Anything left blank shows as [a reminder].
BUSINESS_NAME=
SUPPORT_EMAIL=
JURISDICTION=Pune, Maharashtra
POLICY_EFFECTIVE_DATE=16 September 2026
